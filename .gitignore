*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj

# VS Code and JetBrains Rider folders
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt
crashreports/

# Keep meta files for assets
!/[Aa]ssets/**/*.meta
!/[Pp]rojectSettings/**/*.asset

# Optional: ignore builds & player outputs
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dll
*.pdb
